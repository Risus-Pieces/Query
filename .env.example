# --- Database (Neon) ---
# Neon dashboard -> Connect -> pooled connection string (include ?sslmode=require)
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- Dashboard login ---
DASHBOARD_PASSWORD=choose-a-long-passphrase
SESSION_SECRET=generate-with-openssl-rand-hex-32

# --- Research agent (runs in GitHub Actions or locally) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
# RESEARCH_MODEL=claude-opus-5-5
# RESEARCH_MAX_SEARCHES=10
# HOME_BASE=Houston, TX

# --- Weekly email digest (Resend: https://resend.com) ---
RESEND_API_KEY=re_...
DIGEST_TO=you@example.com
DIGEST_FROM=Query <digest@yourdomain.com>
DASHBOARD_URL=https://your-app.vercel.app
# DIGEST_MIN_SCORE=55
